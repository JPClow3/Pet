{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pethub",
  "account_id": "3c40024664aa7a397235ba6029faed8f",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "https://pethub.joaopaulo-grv4.workers.dev",
    "PUSH_ENABLED": "false"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Local preview: set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // to the pethub_api URL (same value as DATABASE_URL). Do not commit the secret.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cb0363e86fb8499cbc66c990928345a7"
    }
  ]
}
