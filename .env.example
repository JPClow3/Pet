# Public brand: Zelupi. Keep existing database/provider resource identifiers.
# Set only after controlling the production HTTPS origin:
# SITE_URL=https://YOUR_VERIFIED_ZELUPI_DOMAIN

NEON_AUTH_BASE_URL=https://YOUR_ENDPOINT.neonauth.REGION.aws.neon.tech/pethub/auth
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://pethub_api:PASSWORD@YOUR_ENDPOINT/pethub?sslmode=require
# Production app queries use the HYPERDRIVE binding (role pethub_api).
# `next dev` and Vitest fall back to DATABASE_URL when that binding is absent.
# For `pnpm cf:preview` or `wrangler dev`, set the same URL as:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Optional Web Push. Enable after migration 006 and restricted dispatcher setup.
PUSH_ENABLED=false
PUSH_DATABASE_URL=postgresql://pethub_push_api:PASSWORD@YOUR_ENDPOINT/pethub?sslmode=require
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=https://YOUR_VERIFIED_ZELUPI_DOMAIN

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ORG=joao-paulo-goncalves-santos
SENTRY_PROJECT=pethub
